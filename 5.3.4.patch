+```go
+// server/store/repository/errors.go
+
+package repository
+
+import (
+    "database/sql"
+    "errors"
+    "fmt"
+)
+
+var (
+    ErrNotFound   = sql.ErrNoRows
+    ErrDuplicate  = errors.New("record already exists")
+)
+
+// ErrInternal 包装内部错误，避免直接暴露底层存储实现细节。
+type ErrInternal struct {
+    Operation string
+    Cause     error
+}
+
+func (e *ErrInternal) Error() string {
+    return fmt.Sprintf("repository: %s failed: %v", e.Operation, e.Cause)
+}
+
+func (e *ErrInternal) Unwrap() error {
+    return e.Cause
+}
+```
+
+### 1.4 依赖注入容器
+
+```go
+// server/store/repository/container.go
+
+package repository
+
+import "context"
+
+// Repositories 是聚合所有 Repository 的依赖注入容器。
+type Repositories struct {
+    User     UserRepository
+    Pipeline PipelineRepository
+    Repo     RepoRepository
+    // ... 可按需扩展
+}
+
+type containerKey struct{}
+
+// InjectToContext 将 Repositories 注入 context。
+func InjectToContext(ctx context.Context, repos *Repositories) context.Context {
+    return context.WithValue(ctx, containerKey{}, repos)
+}
+
+// FromContext 从 context 中取出 Repositories。
+func FromContext(ctx context.Context) *Repositories {
+    repos, _ := ctx.Value(containerKey{}).(*Repositories)
+    return repos
+}
+```
+
+### 1.5 重构后 API Handler 伪代码
+
+```go
+// server/api/users.go（重构后）
+
+package api
+
+import (
+    "errors"
+    "net/http"
+
+    "github.com/gin-gonic/gin"
+
+    "go.woodpecker-ci.org/woodpecker/v3/server/model"
+    "go.woodpecker-ci.org/woodpecker/v3/server/router/middleware/session"
+    "go.woodpecker-ci.org/woodpecker/v3/server/store/repository"
+)
+
+// GetUsers 获取用户列表
+//
+// 重构要点：
+//   1. 通过 repository.FromContext(c) 获取 Repositories 容器
+//   2. 只调用 repos.User（UserRepository），遵循接口隔离
+//   3. 错误处理按类型映射 HTTP 状态码
+func GetUsers(c *gin.Context) {
+    repos := repository.FromContext(c.Request.Context())
+
+    users, err := repos.User.GetList(c.Request.Context(), session.Pagination(c))
+    if err != nil {
+        respondError(c, err)
+        return
+    }
+
+    for _, user := range users {
+        user.AdminEnv = server.Config.Permissions.Admins.IsAdmin(user)
+    }
+    c.JSON(http.StatusOK, users)
+}
+
+// GetUser 获取单个用户
+func GetUser(c *gin.Context) {
+    repos := repository.FromContext(c.Request.Context())
+
+    forgeID, err := parseForgeID(c)
+    if err != nil {
+        c.AbortWithStatus(http.StatusBadRequest)
+        return
+    }
+
+    var user *model.User
+    remoteID := model.ForgeRemoteID(c.Query("forge_remote_id"))
+
+    if remoteID.IsValid() {
+        user, err = repos.User.GetByRemoteID(c.Request.Context(), forgeID, remoteID)
+    } else {
+        user, err = repos.User.GetByLogin(c.Request.Context(), forgeID, c.Param("login"))
+    }
+    if err != nil {
+        respondError(c, err)
+        return
+    }
+
+    c.JSON(http.StatusOK, user)
+}
+
+// PatchUser 更新用户信息
+func PatchUser(c *gin.Context) {
+    repos := repository.FromContext(c.Request.Context())
+    ctx := c.Request.Context()
+
+    in := &model.User{}
+    if err := c.Bind(in); err != nil {
+        c.AbortWithStatus(http.StatusBadRequest)
+        return
+    }
+
+    user, err := repos.User.GetByRemoteID(ctx, in.ForgeID, in.ForgeRemoteID)
+    if err != nil && !errors.Is(err, repository.ErrNotFound) {
+        respondError(c, err)
+        return
+    }
+    if user == nil {
+        user, err = repos.User.GetByLogin(ctx, in.ForgeID, c.Param("login"))
+        if err != nil {
+            respondError(c, err)
+            return
+        }
+    }
+
+    user.Login = in.Login
+    user.Email = in.Email
+    user.Avatar = in.Avatar
+    user.Admin = in.Admin
+
+    if err := repos.User.Update(ctx, user); err != nil {
+        respondError(c, err)
+        return
+    }
+
+    c.JSON(http.StatusOK, user)
+}
+
+// DeleteUser 删除用户
+func DeleteUser(c *gin.Context) {
+    repos := repository.FromContext(c.Request.Context())
+    ctx := c.Request.Context()
+
+    forgeID, err := parseForgeID(c)
+    if err != nil {
+        c.AbortWithStatus(http.StatusBadRequest)
+        return
+    }
+
+    var user *model.User
+    remoteID := model.ForgeRemoteID(c.Query("forge_remote_id"))
+
+    if remoteID.IsValid() {
+        user, err = repos.User.GetByRemoteID(ctx, forgeID, remoteID)
+    } else {
+        user, err = repos.User.GetByLogin(ctx, forgeID, c.Param("login"))
+    }
+    if err != nil {
+        respondError(c, err)
+        return
+    }
+
+    if err := repos.User.Delete(ctx, user); err != nil {
+        respondError(c, err)
+        return
+    }
+
+    c.Status(http.StatusNoContent)
+}
+
+// ============================================================
+// 统一错误处理函数（替代原来的 handleDBError）
+// ============================================================
+
+// respondError 根据 Repository 层返回的错误类型映射 HTTP 状态码。
+//
+// 映射规则：
+//   - repository.ErrNotFound        → 404 Not Found
+//   - repository.ErrDuplicate       → 409 Conflict
+//   - repository.ErrInternal        → 500 Internal Server Error（记录日志）
+//   - 其他未知错误                    → 500 Internal Server Error
+func respondError(c *gin.Context, err error) {
+    switch {
+    case errors.Is(err, repository.ErrNotFound):
+        c.AbortWithStatus(http.StatusNotFound)
+    case errors.Is(err, repository.ErrDuplicate):
+        c.AbortWithStatus(http.StatusConflict)
+    default:
+        var repoErr *repository.ErrInternal
+        if errors.As(err, &repoErr) {
+            log.Error().Err(repoErr.Cause).Str("op", repoErr.Operation).Msg("repository error")
+        }
+        _ = c.AbortWithError(http.StatusInternalServerError, err)
+    }
+}
+```
+
+### 1.6 重构前后对比
+
+```
+重构前依赖关系：
+┌──────────────────┐
+│   api/users.go   │
+│  api/pipeline.go │
+│  api/repo.go     │
+│  ...             │
+└───────┬──────────┘
+        │ 依赖 store.FromContext(c)
+        ▼
+┌──────────────────────────────────┐
+│         store.Store              │
+│  ~130 methods:                   │
+│   GetUser, GetRepo, GetPipeline, │
+│   CreateUser, CreateRepo, ...    │
+│   SecretCreate, RegistryCreate,  │
+│   AgentCreate, OrgCreate,        │
+│   CronCreate, ForgeCreate, ...   │
+└──────────────────────────────────┘
+        │ 实现
+        ▼
+┌──────────────────────────────────┐
+│   datastore (XORM/SQL 实现)      │
+└──────────────────────────────────┘
+
+重构后依赖关系：
+┌──────────────────┐       ┌──────────────────┐
+│   api/users.go   │       │ api/pipeline.go   │
+└───────┬──────────┘       └───────┬──────────┘
+        │ 依赖 repos.User          │ 依赖 repos.Pipeline
+        ▼                          ▼
+┌──────────────┐   ┌──────────────┐   ┌──────────────┐
+│ UserRepo     │   │ PipelineRepo │   │ RepoRepo     │
+│ (interface)  │   │ (interface)  │   │ (interface)  │
+└──────┬───────┘   └──────┬───────┘   └──────┬───────┘
+       │ 实现              │ 实现              │ 实现
+       ▼                  ▼                  ▼
+┌──────────────────────────────────────────────────┐
+│  XORMUserRepository / XORMPipelineRepository     │
+│  (各自独立实现，通过 datastore 包访问数据库)       │
+└──────────────────────────────────────────────────┘
+```
+
+**优势**：
+- 每个 Handler 只依赖自己需要的接口，测试时只需 mock 对应 Repository
+- 新增实体类型不需要修改现有接口
+- 存储层实现可以独立演进（替换为其他 ORM 或缓存层）
+
