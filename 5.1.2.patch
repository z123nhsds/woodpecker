+    image: *golang_image
+    commands:
+      - go test -race -cover -coverprofile server-pr-coverage.out -timeout 60s -tags 'test' go.woodpecker-ci.org/woodpecker/v3/cmd/server $(go list go.woodpecker-ci.org/woodpecker/v3/server/... | grep -v '/store')
+      - |
+        coverage="$(go tool cover -func=server-pr-coverage.out | tee /dev/stderr | awk '/^total:/ { gsub(/%/, "", $3); print $3 }')"
