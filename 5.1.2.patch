diff --git a/.pre-commit-config.yaml b/.pre-commit-config.yaml
index 47067d5fc..3639b4430 100644
--- a/.pre-commit-config.yaml
+++ b/.pre-commit-config.yaml
@@ -41,19 +41,19 @@ repos:
         args: [--strict, -c=.yamllint.yaml]
   - repo: local
     hooks:
+      - id: forbid-added-fmt-println
+        name: Reject newly added fmt.Println in Go files.
+        entry: "bash -ec 'if git diff --cached --unified=0 -- \"$@\" | grep -E \"^\\+.*fmt\\.Println\\s*\\(\" >/dev/null; then echo \"Remove fmt.Println debug statements before committing.\"; exit 1; fi' --"
+        language: system
+        types: [go]
+        pass_filenames: true
       - id: yaml-file-extension
         name: Check if YAML files has *.yaml extension.
         entry: YAML filenames must have .yaml extension.
         language: fail
         files: .yml$
         exclude: '^(.gitpod.yml|.github/ISSUE_TEMPLATE/config.yml)$'
